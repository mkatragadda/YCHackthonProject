# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Wise API
WISE_API_TOKEN_SANDBOX=your-wise-sandbox-token
WISE_PROFILE_ID_SANDBOX=your-wise-sandbox-profile-id
WISE_API_TOKEN_LIVE=your-wise-live-token
WISE_PROFILE_ID_LIVE=your-wise-live-profile-id

# AgentPhone (SMS)
AGENTPHONE_API_KEY=your-agentphone-api-key
AGENTPHONE_AGENT_ID=your-agentphone-agent-id
AGENTPHONE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Transfer confirmation URL base
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Skip webhook signature verification in development
SKIP_WEBHOOK_SIGNATURE=false
